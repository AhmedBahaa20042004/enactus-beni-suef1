# ─────────────────────────────────────────────────────────────
#  Enactus New Beni Suef — Environment Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/enactus_db

# JWT — change this to any long random string in production!
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# First admin account (created automatically on first run)
FIRST_ADMIN_EMAIL=admin@enactus-bsu.com
FIRST_ADMIN_PASSWORD=Admin@1234
FIRST_ADMIN_NAME=Admin

# ── SendGrid Email ───────────────────────────────────────────
# 1. Go to https://sendgrid.com and create a free account
# 2. Go to Settings → API Keys → Create API Key (Full Access)
# 3. Paste it below
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address emails are sent FROM (must be verified in SendGrid)
# Go to SendGrid → Settings → Sender Authentication → verify your email
SENDGRID_FROM_EMAIL=noreply@enactus-bsu.com
SENDGRID_FROM_NAME=Enactus New Beni Suef

# The email address that receives new order alerts (your email)
ADMIN_NOTIFY_EMAIL=admin@enactus-bsu.com
